{
  "name": "axmap-desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "axMap 데스크톱 셸 — app/server.mjs 를 띄우고 창으로 가리킨다",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest",
    "dist": "node ../tools/make-icon.mjs && electron-builder --win && node ../tools/shortcut.mjs"
  },
  "build": {
    "appId": "dev.axmap.desktop",
    "productName": "axMap",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.mjs",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../app",
        "to": "core/app"
      },
      {
        "from": "../src",
        "to": "core/src"
      },
      {
        "from": "../bin",
        "to": "core/bin"
      },
      {
        "from": "../corpus",
        "to": "core/corpus"
      },
      {
        "from": "../package.json",
        "to": "core/package.json"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "axmap-setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  }
}
